@model Room
@using _23DTHD6_DemoBanCo.Models

@{
    // Phòng chờ: thông tin phòng, ghế ngồi, nút điều khiển và bàn cờ cho 2 đấu thủ.
    var isOwner = (bool)ViewBag.IsOwner;
    var mySide = (string?)ViewBag.MySide;
    var isReady = (bool)ViewBag.IsMyTurnReady;
    var myRole = (ParticipantRole)ViewBag.MyRole;
    var roomCode = (string)ViewBag.RoomCode;
    var visibility = (RoomVisibility)ViewBag.Visibility;
    var playerCount = (int)ViewBag.PlayerCount;
    var spectatorCount = (int)ViewBag.SpectatorCount;
    var capacity = (int)ViewBag.Capacity;
    var sideTaken = (string)ViewBag.SideTaken;
    var errorMessage = (string?)ViewBag.ErrorMessage;

    // Chỉ đấu thủ mới đổi ghế và sẵn sàng được; khán giả chỉ xem.
    var isPlayer = myRole == ParticipantRole.Player;

    // ICollection dùng toán tử gọi động nên phải ép về List trước khi OrderBy.
    var ordered = Model.Participants.ToList().OrderBy(x => x.JoinedAt).ToList();
    var currentUserId = (int)ViewBag.CurrentUserId;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@Model.Name - Phòng chờ</title>
    <style>
        body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; margin: 0; background: #f4f5f7; color: #222; }
        .wrap { max-width: 1180px; margin: 0 auto; padding: 20px 16px 50px; }
        .layout { display: flex; gap: 20px; align-items: flex-start; flex-wrap: wrap; }

        .card { background: #fff; border: 1px solid #ddd; border-radius: 10px; padding: 16px; }
        .board-col { flex: 1 1 700px; min-width: 320px; }
        .side-col { flex: 0 1 320px; }

        h1 { font-size: 21px; margin: 0 0 4px; }
        h2 { font-size: 16px; margin: 0 0 10px; }
        .muted { color: #777; font-size: 13px; }

        .code-badge { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 20px; letter-spacing: 2px; }

        /* ---- Bảng danh sách người chơi ---- */
        .people { list-style: none; padding: 0; margin: 0; }
        .people li { border: 1px solid #e5e5e5; border-radius: 8px; padding: 10px 12px; margin-bottom: 8px; }
        .who { font-weight: 600; }
        .tag { display: inline-block; font-size: 12px; padding: 1px 7px; border-radius: 10px; background: #eee; margin-left: 6px; }
        .tag.red { background: #fdecea; color: #c5221f; }
        .tag.black { background: #e8f0fe; color: #174ea6; }
        .tag.owner { background: #fef7e0; color: #a06800; }
        .ready-on { color: #137333; font-weight: 600; }
        .ready-off { color: #999; }

        /* ---- Bàn cờ: container riêng, KHÔNG chung với bảng người chơi vì
               ChessBoardView.init() gọi innerHTML = '' nên xoá sạch bên trong. ---- */
        #boardRoot { position: relative; width: 100%; max-width: 660px; margin: 0 auto; user-select: none; touch-action: none; }
        #boardRoot img.board-image { display: block; width: 100%; height: auto; pointer-events: none; }
        .xb-layer { position: absolute; inset: 0; }
        .xb-piece { position: absolute; width: 7%; height: auto; transform: translate(-50%, -50%); z-index: 10; pointer-events: auto; transition: left .18s ease, top .18s ease, transform .18s ease; }
        .xb-piece.xb-noanim { transition: none; }
        .xb-piece.xb-dragging { transition: none; z-index: 40; cursor: grabbing; }
        .xb-piece.xb-side-red { border-radius: 50%; box-shadow: 0 0 0 2px #d32f2f, 0 1px 3px rgba(0,0,0,.35); }
        .xb-piece.xb-side-black { border-radius: 50%; box-shadow: 0 0 0 2px #1565c0, 0 1px 3px rgba(0,0,0,.35); }
        .xb-marker { position: absolute; transform: translate(-50%, -50%); pointer-events: none; z-index: 5; }
        .xb-marker-target { width: 4.2%; padding-bottom: 4.2%; height: 0; border-radius: 50%; background: rgba(25,135,84,.45); }
        .xb-marker-capture { width: 8.4%; padding-bottom: 8.4%; height: 0; border-radius: 50%; border: 2px solid #d32f2f; box-sizing: border-box; animation: xb-blink 1s ease-in-out infinite; }
        .xb-marker-last { width: 8.4%; padding-bottom: 8.4%; height: 0; border-radius: 4px; border: 2px solid #ff8f00; box-sizing: border-box; }
        .xb-marker-check { width: 8.8%; padding-bottom: 8.8%; height: 0; border-radius: 50%; border: 3px solid #d32f2f; box-sizing: border-box; animation: xb-shake .5s ease-in-out infinite; }
        .xb-selection { position: absolute; width: 8.4%; padding-bottom: 8.4%; height: 0; border-radius: 50%; border: 2px dashed #1a73e8; box-sizing: border-box; pointer-events: none; z-index: 20; }
        .xb-status { text-align: center; font-size: 14px; color: #555; margin-top: 10px; min-height: 18px; }

        @@keyframes xb-blink { 0%,100% { opacity: .35; } 50% { opacity: 1; } }
        @@keyframes xb-shake {
            0%,100% { transform: translate(-50%,-50%) scale(1); }
            25% { transform: translate(-50%,-50%) scale(1.06); }
            75% { transform: translate(-50%,-50%) scale(.98); }
        }

        /* ---- Chat ---- */
        .chat-panel { display: flex; flex-direction: column; height: 420px; border: 1px solid #ddd; border-radius: 8px; background: #fff; overflow: hidden; }
        .chat-header { padding: 12px 14px; font-weight: 600; border-bottom: 1px solid #eee; }
        .chat-messages { flex: 1; padding: 10px; overflow-y: auto; text-align: left; }
        .chat-message { padding: 6px 4px; border-bottom: 1px solid #f0f0f0; word-break: break-word; }
        .no-message { margin-top: 16px; text-align: center; color: #999; }
        .chat-input { display: flex; padding: 9px; gap: 8px; border-top: 1px solid #eee; }
        .chat-input input { flex: 1; min-width: 0; padding: 8px; border: 1px solid #ccc; border-radius: 5px; }
        .chat-input button { padding: 8px 14px; border: none; border-radius: 5px; background: #1a73e8; color: #fff; cursor: pointer; }

        button { padding: 9px 14px; border: none; border-radius: 6px; background: #1a73e8; color: #fff; cursor: pointer; font-size: 14px; font-weight: 600; }
        button:hover { background: #1558b0; }
        button.secondary { background: #fff; color: #333; border: 1px solid #ccc; }
        button.secondary:hover { background: #f2f2f2; }
        button.danger { background: #d93025; }
        button.danger:hover { background: #b3251c; }
        button:disabled { opacity: .5; cursor: not-allowed; }
        .row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
        .alert { background: #fdecea; border: 1px solid #f5c6c2; color: #c5221f; padding: 10px 12px; border-radius: 8px; margin-bottom: 14px; font-size: 14px; }
        .qr { width: 190px; border: 1px solid #ddd; border-radius: 8px; padding: 6px; background: #fff; }
        input[type=text] { padding: 8px 10px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; width: 100%; box-sizing: border-box; }

        /* ---- Lớp đếm ngược 3-2-1 ---- */
        .countdown { position: fixed; inset: 0; background: rgba(0,0,0,.65); z-index: 200; display: flex; align-items: center; justify-content: center; }
        .countdown-inner { text-align: center; color: #fff; }
        #countdownNum { font-size: 110px; font-weight: 800; line-height: 1; }
        .countdown-sub { font-size: 17px; margin-top: 10px; opacity: .9; }

        /* ---- Hai ghế ---- */
        .seat { border: 1px solid #e2e2e2; border-radius: 8px; padding: 10px 12px; margin-bottom: 8px; }
        .seat-name { font-weight: 600; }
        .seat.red .seat-name { color: #c5221f; }
        .seat.black .seat-name { color: #174ea6; }
        .seat-empty { color: #999; font-style: italic; }

        /* Khi đã vào ván: ẩn phần phòng chờ, chỉ còn bàn cờ */
        .in-match #waitingArea { display: none; }
    </style>
</head>
<body>
    <!-- cotuong.js gọi createApp(...).mount("#app"), nên phần chat có binding
         v-if / v-for / v-model phải nằm trong #app, nếu không Vue sẽ không mount. -->
    <div id="app">
    <div class="wrap">

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert">@errorMessage</div>
        }

        @* Đếm ngược 3-2-1 trước khi vào ván (đặc tả 2.3). Ẩn mặc định. *@
        <div id="countdown" class="countdown" style="display:none;">
            <div class="countdown-inner">
                <div id="countdownNum">3</div>
                <div class="countdown-sub" id="countdownSub">Cả hai đã sẵn sàng</div>
            </div>
        </div>

        <div id="waitingArea">

        <div class="layout">

            <!-- ============ CỘT BÀN CỜ ============ -->
            <div class="board-col">
                <div class="card">
                    <h1>@Model.Name</h1>
                    <div class="muted">
                        Mã phòng <span class="code-badge">@roomCode</span> &middot;
                        Trạng thái: @Model.Status
                    </div>

                    <div class="row">
                        <button type="button" class="secondary" id="soundToggle" title="Bật / tắt âm thanh">&#128266; &#8963;</button>
                        <span class="muted" id="turnStatus">Chưa có ván nào bắt đầu.</span>
                    </div>

                    <!-- Container RIÊNG cho bàn cờ. ChessBoardView.init() sẽ xoá
                         sạch innerHTML của phần tử này nên không được chứa
                         thêm danh sách người chơi hay nút bấm nào bên trong. -->
                    <div id="boardRoot"></div>
                </div>
            </div>

            <!-- ============ CỘT PHÒNG CHỜ ============ -->
            <div class="side-col">

                <div class="card" style="margin-bottom: 16px;">
                    <h2>Hai ghế cờ</h2>
                    @{
                        var redPlayer = ordered.FirstOrDefault(p => p.Side == "do");
                        var blackPlayer = ordered.FirstOrDefault(p => p.Side == "den");
                    }
                    <div class="seat red">
                        <div class="seat-name">Ghế Đỏ (đi trước)</div>
                        <div id="seatRed">@(redPlayer == null
                            ? (object)"<span class='seat-empty'>Trống</span>"
                            : redPlayer.User?.DisplayName ?? "Người chơi")</div>
                    </div>
                    <div class="seat black">
                        <div class="seat-name">Ghế Đen (đi sau)</div>
                        <div id="seatBlack">@(blackPlayer == null
                            ? (object)"<span class='seat-empty'>Trống</span>"
                            : blackPlayer.User?.DisplayName ?? "Người chơi")</div>
                    </div>
                </div>

                <div class="card" style="margin-bottom: 16px;">
                    <h2>Người trong phòng (@playerCount/2 đấu thủ &middot; @spectatorCount/@(capacity - 2) khán giả)</h2>

                    <ul class="people">
                        @foreach (var p in ordered)
                        {
                            var isThisRoomOwner = p.UserId == Model.OwnerId;
                            var sideLabel = p.Side == "do" ? "Đỏ" : p.Side == "den" ? "Đen" : "Chưa chọn";
                            <li>
                                <div>
                                    <span class="who">@(p.User?.DisplayName ?? "Người chơi")</span>
                                    @if (isThisRoomOwner)
                                    {
                                        <span class="tag owner">Chủ phòng</span>
                                    }
                                    <span class="tag @(p.Side == "do" ? "red" : "black")">@sideLabel</span>
                                    <span class="tag">@(p.Role == ParticipantRole.Spectator ? "Khán giả" : "Đấu thủ")</span>
                                </div>
                                <div class="@(p.IsReady ? "ready-on" : "ready-off")">
                                    @(p.IsReady ? "Đã sẵn sàng" : "Chưa sẵn sàng")
                                </div>
                                @if (isOwner && p.UserId != (int)ViewBag.CurrentUserId)
                                {
                                    <form asp-controller="Room" asp-action="Kick" method="post" style="margin-top:8px;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="roomId" value="@Model.Id" />
                                        <input type="hidden" name="targetUserId" value="@p.UserId" />
                                        <button type="submit" class="danger">Đuổi</button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                </div>

                <div class="card" style="margin-bottom: 16px;">
                    <h2>Chia sẻ phòng</h2>
                    <label for="inviteLink">Link mời</label>
                    <a asp-controller="Room" asp-action="JoinByCode" asp-route-code="@roomCode">@Url.Action("JoinByCode", "Room", new { code = roomCode })</a>
                    <div class="row">
                        <span class="muted">Quét mã để vào phòng:</span>
                    </div>
                    @if (isOwner)
                    {
                        <img class="qr" alt="Mã QR vào phòng"
                             src="@Url.Action("QrCode", "Room", new { roomId = Model.Id, scope = "join" })" />
                    }
                    else
                    {
                        <div class="muted">Chỉ chủ phòng mới xem được mã QR mời.</div>
                    }
                </div>

                @if (isPlayer)
                {
                    <div class="card" style="margin-bottom: 16px;">
                        <h2>Ghế của tôi: <span id="mySideLabel">@(mySide == "do" ? "Đỏ" : mySide == "den" ? "Đen" : "Chưa chọn")</span></h2>

                        @* Trạng thái sẵn sàng cập nhật bằng RoomParticipantsChanged,
                           không tải lại trang. *@
                        <p class="muted">
                            Sẵn sàng: <strong id="readyCount">@Model.Participants.Count(p => p.IsReady && p.Role == ParticipantRole.Player)</strong>/2
                            <span id="readyHint" class="muted"></span>
                        </p>

                        @if (isPlayer)
                        {
                            <button type="button" id="btnReady" data-ready="@(isReady ? "true" : "false")">
                                @(isReady ? "Huỷ sẵn sàng" : "Sẵn sàng")
                            </button>
                        }
                        else
                        {
                            <div class="muted">Bạn là khán giả nên không bấm sẵn sàng được.</div>
                        }

                        <div class="row">
                            @{
                                bool redFree = sideTaken != "do" && mySide != "do";
                                bool blackFree = sideTaken != "den" && mySide != "den";
                            }
                            <form asp-controller="Room" asp-action="SwitchSide" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="roomId" value="@Model.Id" />
                                <input type="hidden" name="side" value="do" />
                                <button type="submit" class="secondary" disabled="@(!redFree)">Ghế Đỏ</button>
                            </form>
                            <form asp-controller="Room" asp-action="SwitchSide" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="roomId" value="@Model.Id" />
                                <input type="hidden" name="side" value="den" />
                                <button type="submit" class="secondary" disabled="@(!blackFree)">Ghế Đen</button>
                            </form>
                        </div>
                        <div class="row">
                            <form asp-controller="Room" asp-action="RequestSwap" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="roomId" value="@Model.Id" />
                                <button type="submit" class="secondary">Xin đổi bên</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card" style="margin-bottom: 16px;">
                        <h2>Bạn đang xem với vai khán giả</h2>
                        <p class="muted">Hai ghế đã có người ngồi, nên bạn vào phòng với vai trò khán giả.</p>
                    </div>
                }

                @if (isOwner)
                {
                    <div class="card" style="margin-bottom: 16px;">
                        <h2>Chủ phòng</h2>

                        <form asp-controller="Room" asp-action="ChangeVisibility" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="roomId" value="@Model.Id" />
                            <label for="visSelect">Chế độ phòng</label>
                            <select id="visSelect" name="visibility" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:6px;">
                                @* selected phải sinh ra thuộc tính CÓ hoặc KHÔNG.
                                   selected="False" vẫn bị HTML coi là có, nên phải
                                   dùng selected="@(cond ? "selected" : "")". *@
                                <option value="Public" selected="@(visibility == RoomVisibility.Public ? "selected" : "")">Công khai - ai cũng thấy trong sảnh</option>
                                <option value="CodeOnly" selected="@(visibility == RoomVisibility.CodeOnly ? "selected" : "")">Chỉ vào bằng mã</option>
                                <option value="Locked" selected="@(visibility == RoomVisibility.Locked ? "selected" : "")">Khoá - không ai vào từ bên ngoài</option>
                            </select>
                            <div class="row">
                                <button type="submit">Lưu chế độ</button>
                            </div>
                        </form>

                        <form asp-controller="Room" asp-action="Delete" method="post" onsubmit="return confirm('Xoá phòng này?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="row">
                                <button type="submit" class="danger">Xoá phòng</button>
                            </div>
                        </form>
                    </div>
                }

                <div class="card">
                    <h2>Trò chuyện</h2>
                    <div class="chat-panel">
                        <div class="chat-header">Tin nhắn phòng</div>
                        <div class="chat-messages" ref="chatMessages">
                            <div v-if="messages.length === 0" class="no-message">Chưa có tin nhắn</div>
                            <div v-for="(item, index) in messages" :key="index" class="chat-message">
                                <strong>@@item.userName</strong>: @@item.message
                            </div>
                        </div>
                        <div class="chat-input">
                            <input type="text" v-model="chatMessage" placeholder="Nhập tin nhắn..." @@keyup.enter="sendMessage" />
                            <button type="button" @@click="sendMessage">Gửi</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        </div>

        <p class="muted" style="margin-top:16px;">
            <a asp-controller="Room" asp-action="Lobby">Về sảnh</a> &middot;
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
        </p>
    </div>
    </div>


    <!-- Bản cờ và âm thanh phải nạp TRƯỚC cotuong.js: cotuong.js tra
         window.ChessBoardView / window.SoundBoard để nối sự kiện. -->
    <script src="https://unpkg.com/vue@@3/dist/vue.global.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="/js/audio.js"></script>
    <script src="/js/chess-board.js"></script>

    <!-- Phải đặt TRƯỚC cotuong.js: file này đọc window.__roomId ngay khi tạo
         Vue app. Không có nó thì roomId rỗng và lệnh JoinRoom sẽ hỏng. -->
    <script>window.__roomId = @Model.Id;</script>
    <script>window.__myUserId = @currentUserId;</script>
    <script src="/js/cotuong.js"></script>

    <script>
        /* ==============================================================
           NGUỒN SỰ THẬT DUY NHẤT CHO CHAT
           cotuong.js đã gán window.__onChatReceived trong mounted(),
           nên trang chỉ việc đẩy tin vào window.__chatMessages rồi gọi hook.
           ============================================================== */
        window.__chatMessages = window.__chatMessages || [];

        (function () {
            const roomId = window.__roomId;
            const myUserId = window.__myUserId;

            /* ---------- Bàn cờ: đúng 2 tham số, module không biết SignalR ----------
               init() trả về chính đối tượng ChessBoardView (return this) nên
               window.board dùng được ngay. */
            const boardRoot = document.getElementById('boardRoot');
            if (boardRoot && window.ChessBoardView) {
                window.board = window.ChessBoardView.init(boardRoot, '/images/');
            }

            /* ---------- Vẽ 32 quân NGAY, không chờ có ván đấu ----------
               Phòng chờ chưa có MatchUpdated nên bàn trống. Nạp thế cờ
               khởi tạo từ API ngay khi trang mở, để người chơi thấy bàn cờ
               thật thay vì khung trống. Khi ván bắt đầu, MatchUpdated sẽ ghi
               đè bằng thế cờ thật qua applyMatch(). */
            function loadInitialPieces() {
                if (!window.board) return Promise.resolve();

                return fetch('/api/BanCo/getboard')
                    .then(function (response) {
                        if (!response.ok) throw new Error('HTTP ' + response.status);
                        return response.json();
                    })
                    .then(function (data) {
                        if (data && Array.isArray(data.pieces) && data.pieces.length) {
                            window.board.setPieces(data.pieces);
                        }
                    })
                    .catch(function (error) {
                        console.error('Không nạp được thế cờ khởi tạo:', error);
                    });
            }

            loadInitialPieces();

            /* ---------- Nút loa ---------- */
            const soundBtn = document.getElementById('soundToggle');
            if (soundBtn && window.SoundBoard) {
                soundBtn.addEventListener('click', function () {
                    window.SoundBoard.setMuted(!window.SoundBoard.isMuted());
                    soundBtn.textContent = window.SoundBoard.isMuted() ? '🔇' : '🔊';
                });
            }

            /* ---------- MỘT connection cho cả trang ----------
               cotuong.js tự tạo connection riêng nhưng KHÔNG export ra ngoài
               (createApp(...).mount("#app") không gán vào biến nào), nên bản cũ
               poll window.MatchConnection — biến này không bao giờ được gán nên
               handler chưa từng đăng ký, bàn vì thế trống.

               Không lấy được connection đó thì tạo MỘT connection ở đây và tự
               lo phần vào phòng. Vẫn chỉ có 1 kết nối SignalR thật sự: hub
               gom theo ConnectionId, nên gọi JoinRoom thêm một lần chỉ cập
               nhật đúng bản ghi participant (RoomService.AddParticipantAsync
               update ConnectionId nếu đã có) chứ không tạo người chơi trùng. */
            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/chessHub')
                .withAutomaticReconnect()
                .build();

            window.MatchConnection = connection;

            let currentMatchId = null;

            connection.on('ReceiveChat', function (message) {
                const text = (message.kind === 1 && message.sticker) ? message.sticker : message.body;

                window.__chatMessages.push({
                    userName: message.displayName,
                    message: text
                });

                if (typeof window.__onChatReceived === 'function') {
                    window.__onChatReceived(window.__chatMessages);
                }
            });

            /* ---------- Trạng thái hiển thị của phòng chờ ---------- */
            let countdownTimer = null;

            function setSeats(participants) {
                const red = document.getElementById('seatRed');
                const black = document.getElementById('seatBlack');
                if (!red || !black) return;

                const findBySide = function (side) {
                    return (participants || []).find(function (p) { return p.side === side; });
                };

                const redPlayer = findBySide('do');
                const blackPlayer = findBySide('den');

                red.innerHTML = redPlayer
                    ? escapeHtml(redPlayer.displayName)
                    : "<span class='seat-empty'>Trống</span>";
                black.innerHTML = blackPlayer
                    ? escapeHtml(blackPlayer.displayName)
                    : "<span class='seat-empty'>Trống</span>";
            }

            function escapeHtml(value) {
                return String(value == null ? '' : value).replace(/[&<>"']/g, function (c) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                });
            }

            function updateReadyUI(participants) {
                const players = (participants || []).filter(function (p) { return p.role === 'Player'; });
                const readyCount = players.filter(function (p) { return p.isReady; }).length;

                const el = document.getElementById('readyCount');
                if (el) el.textContent = readyCount;

                const hint = document.getElementById('readyHint');
                if (hint) {
                    hint.textContent = players.length < 2
                        ? '(cần đủ 2 người)'
                        : readyCount >= 2 ? '(đủ, đang bắt đầu...)' : '(chờ đối thủ)';
                }

                const me = players.find(function (p) { return p.userId === myUserId; });
                const sideLabel = document.getElementById('mySideLabel');
                if (sideLabel && me) {
                    sideLabel.textContent = me.side === 'do' ? 'Đỏ' : me.side === 'den' ? 'Đen' : 'Chưa chọn';
                }

                const btn = document.getElementById('btnReady');
                if (btn && me) {
                    btn.dataset.ready = me.isReady ? 'true' : 'false';
                    btn.textContent = me.isReady ? 'Huỷ sẵn sàng' : 'Sẵn sàng';
                }

                return { players: players, readyCount: readyCount };
            }

            /* ---------- Đếm ngược 3-2-1 (đặc tả 2.3) ----------
               Chỉ để hiển thị. Việc tạo ván đã do server tự làm trong
               ToggleReady -> TryStartMatchAsync, nên client KHÔNG invoke
               StartMatch ở đây: làm vậy sẽ thành nguồn tạo ván thứ hai. */
            function startCountdown(participants) {
                const red = participants.find(function (p) { return p.side === 'do'; });
                const black = participants.find(function (p) { return p.side === 'den'; });

                // Chưa đủ hai ghế thì chưa hiện đồng hồ đếm
                if (!red || !black) return;

                if (countdownTimer) return;

                const overlay = document.getElementById('countdown');
                const num = document.getElementById('countdownNum');
                if (!overlay || !num) return;

                overlay.style.display = 'flex';

                let n = 3;
                num.textContent = n;

                countdownTimer = setInterval(function () {
                    n -= 1;
                    if (n > 0) {
                        num.textContent = n;
                        return;
                    }

                    clearInterval(countdownTimer);
                    countdownTimer = null;
                    overlay.style.display = 'none';
                }, 1000);
            }


            connection.on('RoomParticipantsChanged', function (data) {
                const people = (data && data.participants) || [];
                setSeats(people);
                const state = updateReadyUI(people);

                // Hai đấu thủ đã sẵn sàng: hiện đồng hồ đếm cho tới khi server
                // báo MatchStarted. Không tự gọi StartMatch ở đây.
                if (state.players.length >= 2 && state.readyCount >= 2) {
                    startCountdown(people);
                }
            });

            connection.on('RoomStateChanged', function (data) {
                console.log('RoomStateChanged', data);
            });

            connection.on('MatchStarted', function (payload) {
                currentMatchId = payload.matchId;

                if (countdownTimer) {
                    clearInterval(countdownTimer);
                    countdownTimer = null;
                }

                const overlay = document.getElementById('countdown');
                if (overlay) overlay.style.display = 'none';

                // Đã vào ván: ẩn phần phòng chờ, chỉ còn bàn cờ.
                document.body.classList.add('in-match');

                // Vẽ ngay thế cờ khởi tạo, không chờ MatchUpdated tới sau.
                if (window.board && payload.fen) {
                    window.board.applyMatch({
                        fen: payload.fen,
                        turnSide: payload.turnSide,
                        yourSide: payload.redUserId === myUserId ? 0
                            : payload.blackUserId === myUserId ? 1 : -1,
                        canMove: false,
                        legalMoves: []
                    });
                }

                const turn = document.getElementById('turnStatus');
                if (turn) turn.textContent = 'Ván đã bắt đầu.';
            });

            /* ---------- Nút sẵn sàng: gọi hub, không POST ---------- */
            const readyBtn = document.getElementById('btnReady');
            if (readyBtn) {
                readyBtn.addEventListener('click', function () {
                    const next = readyBtn.dataset.ready !== 'true';
                    connection.invoke('ToggleReady', roomId, next)
                        .catch(function (err) {
                            console.error('Không đổi được trạng thái sẵn sàng:', err);
                        });
                });
            }

            connection.on('MatchUpdated', function (payload) {
                currentMatchId = payload.matchId;

                if (window.board) {
                    /* applyMatch() tự parse FEN, vẽ lại quân, tô ô hợp lệ,
                       đổi lượt và xoay bàn theo phe. */
                    window.board.applyMatch(payload);
                }

                const turn = document.getElementById('turnStatus');
                if (turn) {
                    turn.textContent = payload.canMove ? 'Đến lượt bạn.' : 'Chờ đối thủ...';
                }
            });

            /* ---------- Gửi nước đi: tên hàm client là SubmitMove ---------- */
            if (window.board) {
                window.board.onMove = function (from, to, pieceId) {
                    if (!currentMatchId) {
                        console.warn('Chưa có ván nào đang diễn ra');
                        return;
                    }

                    connection.invoke('SubmitMove', currentMatchId, {
                        pieceId: pieceId,
                        fromRow: from.row,
                        fromCol: from.col,
                        toRow: to.row,
                        toCol: to.col
                    }).then(function (result) {
                        if (result && result.success === false) {
                            console.warn('Nước đi bị từ chối:', result.error);
                        }
                    }).catch(function (err) {
                        console.error('Lỗi gửi nước đi', err);
                    });
                };
            }

            /* Chỉ vào phòng khi connection ĐÃ ở trạng thái Connected, nếu không
               invoke sẽ ném "Cannot send data if the connection is not in the
               Connected State". */
            connection.start()
                .then(function () {
                    if (!roomId || roomId <= 0) return;
                    return connection.invoke('JoinRoom', roomId, null);
                })
                .then(function () {
                    console.log('Đã vào phòng', roomId);
                })
                .catch(function (err) {
                    console.error('Không kết nối được phòng:', err);
                });

        })();
    </script>
</body>
</html>
