@model Room
@using _23DTHD6_DemoBanCo.Models
@using _23DTHD6_DemoBanCo.Services

@{
    // Phòng chờ + phòng thi đấu (SCR-WAITING-ROOM và SCR-GAME-ROOM dùng chung một trang).
    //
    // Ba luật hiển thị quan trọng:
    //   - Khán giả KHÔNG thấy tab Kênh Riêng (đặc tả 5.3): chỉ hiện Kênh Chung.
    //   - Đấu thủ mở sẵn Kênh Riêng, có thêm công tắc "Ẩn kênh chung".
    //   - Ván xếp hạng cấm Undo vĩnh viễn, nên nút bị ẩu hoàn toàn chứ không chỉ
    //     vô hiệu hóa (đặc tả EC-01).
    var isOwner = (bool)ViewBag.IsOwner;
    var mySide = (string?)ViewBag.MySide;
    var isReady = (bool)ViewBag.IsMyTurnReady;
    var myRole = (ParticipantRole)ViewBag.MyRole;
    var roomCode = (string)ViewBag.RoomCode;
    var visibility = (RoomVisibility)ViewBag.Visibility;
    var playerCount = (int)ViewBag.PlayerCount;
    var spectatorCount = (int)ViewBag.SpectatorCount;
    var capacity = (int)ViewBag.Capacity;
    var sideTaken = (string)ViewBag.SideTaken;
    var errorMessage = (string?)ViewBag.ErrorMessage;
    var currentUserId = (int)ViewBag.CurrentUserId;

    var isPlayer = myRole == ParticipantRole.Player;
    var isRanked = Model.MatchType == MatchType.Ranked;
    var allowUndo = isPlayer && !isRanked;

    var ordered = Model.Participants.ToList().OrderBy(x => x.JoinedAt).ToList();
    var redPlayer = ordered.FirstOrDefault(p => p.Side == "do");
    var blackPlayer = ordered.FirstOrDefault(p => p.Side == "den");

    // 12 sticker cảm xúc nhanh (đặc tả 5.1), lấy từ danh sách server để client và
    // server luôn dùng chung một bộ mã, không lệch.
    var stickers = ChatService.Stickers;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@Model.Name - Phòng chờ</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <style>
        body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; margin: 0; background: #f4f5f7; color: #222; }
        .wrap { max-width: 1200px; margin: 0 auto; padding: 18px 16px 46px; }
        .layout { display: flex; gap: 18px; align-items: flex-start; flex-wrap: wrap; }
        .board-col { flex: 1 1 660px; min-width: 300px; }
        .side-col { flex: 0 1 340px; }
        .card { background: #fff; border: 1px solid #ddd; border-radius: 10px; padding: 15px; margin-bottom: 14px; }
        h1 { font-size: 20px; margin: 0 0 4px; }
        h2 { font-size: 15px; margin: 0 0 10px; }
        .muted { font-size: 13px; color: #777; line-height: 1.6; }
        .code-badge { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 19px; letter-spacing: 2px; }
        .alert { background: #fdecea; border: 1px solid #f5c6c2; color: #c5221f; padding: 10px 12px; border-radius: 8px; margin-bottom: 14px; font-size: 14px; }
        .note { background: #e8f0fe; border: 1px solid #c6dafc; color: #174ea6; padding: 9px 11px; border-radius: 8px; font-size: 13px; margin-top: 10px; }

        button { padding: 9px 14px; border: none; border-radius: 6px; background: #1a73e8; color: #fff; cursor: pointer; font-size: 14px; font-weight: 600; }
        button:hover { background: #1558b0; }
        button.secondary { background: #fff; color: #333; border: 1px solid #ccc; }
        button.secondary:hover { background: #f0f0f0; }
        button.danger { background: #d93025; }
        button.danger:hover { background: #b3251c; }
        button.ok { background: #188038; }
        button.ok:hover { background: #146c2e; }
        button:disabled { opacity: .5; cursor: not-allowed; }
        .row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 10px; }
        input[type=text] { padding: 8px 10px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; width: 100%; box-sizing: border-box; }
        select { padding: 8px 10px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; width: 100%; box-sizing: border-box; }

        /* ---- Hai ghế ---- */
        .seat { border: 1px solid #e2e2e2; border-radius: 8px; padding: 9px 11px; margin-bottom: 8px; }
        .seat-name { font-weight: 600; }
        .seat.red .seat-name { color: #c5221f; }
        .seat.black .seat-name { color: #174ea6; }
        .seat-empty { color: #999; font-style: italic; }
        .seat-clock { font-variant-numeric: tabular-nums; font-size: 19px; font-weight: 700; margin-left: 8px; }
        .seat-clock.low { color: #d93025; animation: pulse .9s ease-in-out infinite; }
        @@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .45; } }

        /* ---- Bàn cờ ---- */
        #boardRoot { position: relative; width: 100%; max-width: 640px; margin: 0 auto; user-select: none; touch-action: none; }
        #boardRoot img.board-image { display: block; width: 100%; height: auto; pointer-events: none; }
        .xb-layer { position: absolute; inset: 0; }
        .xb-piece { position: absolute; width: 7%; height: auto; transform: translate(-50%, -50%); z-index: 10; transition: left .18s ease, top .18s ease, transform .18s ease; }
        .xb-piece.xb-noanim { transition: none; }
        .xb-piece.xb-dragging { transition: none; z-index: 40; cursor: grabbing; }
        /* Trợ năng DT-21: viền phân biệt phe không dựa vào màu hoa văn. */
        .xb-piece.xb-side-red { border-radius: 50%; box-shadow: 0 0 0 2px #d32f2f, 0 1px 3px rgba(0,0,0,.35); }
        .xb-piece.xb-side-black { border-radius: 50%; box-shadow: 0 0 0 2px #1565c0, 0 1px 3px rgba(0,0,0,.35); }
        .xb-marker { position: absolute; transform: translate(-50%, -50%); pointer-events: none; z-index: 5; }
        .xb-marker-target { width: 4.2%; padding-bottom: 4.2%; height: 0; border-radius: 50%; background: rgba(25,135,84,.45); }
        .xb-marker-capture { width: 8.4%; padding-bottom: 8.4%; height: 0; border-radius: 50%; border: 2px solid #d32f2f; box-sizing: border-box; animation: xb-blink 1s ease-in-out infinite; }
        .xb-marker-last { width: 8.4%; padding-bottom: 8.4%; height: 0; border-radius: 4px; border: 2px solid #ff8f00; box-sizing: border-box; }
        .xb-marker-check { width: 8.8%; padding-bottom: 8.8%; height: 0; border-radius: 50%; border: 3px solid #d32f2f; box-sizing: border-box; animation: xb-shake .5s ease-in-out infinite; }
        .xb-selection { position: absolute; width: 8.4%; padding-bottom: 8.4%; height: 0; border-radius: 50%; border: 2px dashed #1a73e8; box-sizing: border-box; pointer-events: none; z-index: 20; }
        .xb-status { text-align: center; font-size: 14px; color: #555; margin-top: 10px; min-height: 18px; }
        @@keyframes xb-blink { 0%,100% { opacity: .35; } 50% { opacity: 1; } }
        @@keyframes xb-shake {
            0%,100% { transform: translate(-50%,-50%) scale(1); }
            25% { transform: translate(-50%,-50%) scale(1.06); }
            75% { transform: translate(-50%,-50%) scale(.98); }
        }

        /* ---- Chat: tab + sticker ---- */
        .chat-panel { display: flex; flex-direction: column; height: 400px; border: 1px solid #ddd; border-radius: 8px; background: #fff; overflow: hidden; position: relative; }
        .chat-tabs { display: flex; border-bottom: 1px solid #eee; }
        .chat-tabs div { flex: 1; padding: 9px 6px; text-align: center; font-size: 13px; font-weight: 600; color: #666; cursor: pointer; border-bottom: 2px solid transparent; }
        .chat-tabs div.active { color: #1a73e8; border-bottom-color: #1a73e8; }
        .chat-messages { flex: 1; padding: 10px; overflow-y: auto; font-size: 14px; }
        .chat-message { padding: 5px 4px; border-bottom: 1px solid #f4f4f4; word-break: break-word; }
        .chat-message.mine { background: #f0f6ff; }
        .no-message { padding: 24px 0; text-align: center; color: #999; }
        .chat-input { display: flex; padding: 8px; gap: 7px; border-top: 1px solid #eee; }
        .chat-input input { flex: 1; min-width: 0; padding: 8px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px; }
        .chat-input button { padding: 8px 12px; }
        .sticker-tray { position: absolute; bottom: 56px; left: 10px; background: #fff; border: 1px solid #ddd; border-radius: 10px; padding: 9px; display: none; grid-template-columns: repeat(6, 38px); gap: 5px; box-shadow: 0 6px 20px rgba(0,0,0,.16); z-index: 30; }
        .sticker-tray.open { display: grid; }
        .sticker-tray button { background: transparent; font-size: 21px; padding: 5px; border-radius: 6px; }
        .sticker-tray button:hover { background: #f0f0f0; }

        /* ---- Danh sách người ---- */
        .people { list-style: none; padding: 0; margin: 0; }
        .people li { border-bottom: 1px solid #eee; padding: 9px 2px; display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }
        .people li:last-child { border-bottom: none; }
        .who { font-weight: 600; font-size: 14px; }
        .tag { display: inline-block; font-size: 11px; padding: 1px 7px; border-radius: 10px; background: #eee; margin-left: 5px; }
        .tag.red { background: #fdecea; color: #c5221f; }
        .tag.black { background: #e8f0fe; color: #174ea6; }
        .tag.owner { background: #fef7e0; color: #a06800; }
        .ready-on { color: #137333; font-weight: 600; font-size: 13px; }
        .ready-off { color: #999; font-size: 13px; }
        .qr { width: 170px; border: 1px solid #ddd; border-radius: 8px; padding: 6px; background: #fff; }

        /* ---- Lớp đếm ngược 3-2-1 ---- */
        .countdown { position: fixed; inset: 0; background: rgba(0,0,0,.65); z-index: 200; display: none; align-items: center; justify-content: center; }
        .countdown.open { display: flex; }
        .countdown-inner { text-align: center; color: #fff; }
        #countdownNum { font-size: 110px; font-weight: 800; line-height: 1; }
        .countdown-sub { font-size: 17px; margin-top: 10px; opacity: .9; }

        /* ---- Lớp phủ kết quả ván ---- */
        .overlay { position: fixed; inset: 0; background: rgba(0,0,0,.68); z-index: 210; display: none; align-items: center; justify-content: center; }
        .overlay.open { display: flex; }
        .overlay-box { background: #fff; border-radius: 14px; padding: 26px 32px; text-align: center; max-width: 420px; }
        .overlay-title { font-size: 25px; font-weight: 800; margin-bottom: 8px; }
        .overlay-note { font-size: 14px; color: #666; margin-bottom: 18px; }

        /* ---- Pop-up lời mời vào phòng (đặc tả 2.5) ---- */
        #invitePopup { position: fixed; right: 16px; top: 74px; z-index: 400; display: none; }
        #invitePopup.open { display: block; }
        .invite-inner { background: #fff; border: 2px solid #1a73e8; border-radius: 10px; padding: 14px; width: 290px; box-shadow: 0 8px 26px rgba(0,0,0,.2); }
        .invite-inner h3 { font-size: 14px; margin: 0 0 6px; }
        .invite-timer { font-size: 12px; color: #d93025; font-weight: 600; }

        /* ---- Công cụ demo mạng (đặc tả 9.3) ---- */
        #demoPanel { position: fixed; right: 14px; bottom: 14px; z-index: 300; display: none; }
        #demoPanel.open { display: block; }
        .demo-inner { background: #fff; border: 2px dashed #d93025; border-radius: 10px; padding: 14px; box-shadow: 0 8px 26px rgba(0,0,0,.2); }
        .demo-inner h3 { font-size: 13px; margin: 0 0 6px; color: #d93025; text-transform: uppercase; }

        .in-match #waitingArea { display: none; }
    </style>
</head>
<body>
    <!-- Đếm ngược 3-2-1 trước khi vào ván (đặc tả 2.3). Ẩn mặc định. -->
    <div id="countdown" class="countdown">
        <div class="countdown-inner">
            <div id="countdownNum">3</div>
            <div class="countdown-sub" id="countdownSub">Cả hai đã sẵn sàng</div>
        </div>
    </div>

    <!-- Kết quả ván + nút tái đấu (đặc tả R14) -->
    <div id="endOverlay" class="overlay">
        <div class="overlay-box">
            <div class="overlay-title" id="endTitle">Kết thúc</div>
            <div class="overlay-note" id="endNote"></div>
            <div class="row" style="justify-content:center;">
                <button type="button" id="btnRematch">Tái đấu</button>
                <a class="btn btn-outline-secondary" id="btnReplayEnd" href="#">Xem lại ván</a>
                <a class="btn btn-outline-secondary" asp-controller="Room" asp-action="Lobby">Về sảnh</a>
            </div>
        </div>
    </div>

    <!-- Pop-up lời mời vào phòng, đếm ngược 30 giây (đặc tả 2.5) -->
    <div id="invitePopup">
        <div class="invite-inner">
            <h3>✉️ Lời mời vào phòng</h3>
            <div id="inviteText" class="muted"></div>
            <div class="invite-timer" id="inviteTimer"></div>
            <div class="row" style="margin-top:10px;">
                <button type="button" id="btnInviteAccept">Tham gia</button>
                <button type="button" class="secondary" id="btnInviteDecline">Từ chối</button>
            </div>
        </div>
    </div>

    <!-- Công cụ demo: Ctrl+Shift+D -->
    <div id="demoPanel">
        <div class="demo-inner">
            <h3>Công cụ demo</h3>
            <p class="muted" style="margin:0 0 8px;">Mô phỏng rớt mạng để trình diễn cơ chế chịu lỗi.</p>
            <div class="row" style="margin-top:0;">
                <button type="button" class="danger" id="btnDropNet">Mô phỏng mất mạng</button>
                <button type="button" id="btnReconnect">Tái kết nối tức thì</button>
            </div>
        </div>
    </div>

    <div class="wrap">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert">@errorMessage</div>
        }

        <div id="waitingArea">
        <div class="layout">

            <!-- ============ CỘT BÀN CỜ ============ -->
            <div class="board-col">
                <div class="card">
                    <h1>@Model.Name</h1>
                    <div class="muted">
                        Mã phòng <span class="code-badge">@roomCode</span> &middot;
                        Trạng thái: <span id="roomStatus">@Model.Status</span> &middot;
                        <span id="modeLabel">@(isRanked ? "Xếp hạng" : "Đánh thường")</span>
                    </div>

                    <div class="row">
                        <button type="button" class="secondary" id="soundToggle" title="Bật / tắt âm thanh">&#128266;</button>
                        <span class="muted" id="turnStatus">Chưa có ván nào bắt đầu.</span>
                    </div>

                    <div id="disconnectBanner" class="note" style="display:none;background:#fdecea;border-color:#f5c6c2;color:#c5221f;">
                        <span id="disconnectText"></span>
                    </div>

                    <!-- Container RIÊNG cho bàn cờ: ChessBoardView.init() gọi innerHTML = ''
                         nên không được chứa thêm danh sách hay nút bấm nào bên trong. -->
                    <div id="boardRoot"></div>
                </div>
            </div>

            <!-- ============ CỘT PHÒNG CHỜ ============ -->
            <div class="side-col">

                <div class="card">
                    <h2>Hai ghế cờ</h2>
                    <div class="seat red">
                        <div class="seat-name">Ghế Đỏ (đi trước)
                            <span class="seat-clock" id="clockRed">--:--</span>
                        </div>
                        <div id="seatRed">@(redPlayer == null
                            ? (object)"<span class='seat-empty'>Trống</span>"
                            : redPlayer.User?.DisplayName ?? "Người chơi")</div>
                    </div>
                    <div class="seat black">
                        <div class="seat-name">Ghế Đen (đi sau)
                            <span class="seat-clock" id="clockBlack">--:--</span>
                        </div>
                        <div id="seatBlack">@(blackPlayer == null
                            ? (object)"<span class='seat-empty'>Trống</span>"
                            : blackPlayer.User?.DisplayName ?? "Người chơi")</div>
                    </div>
                </div>

                @if (isPlayer)
                {
                    <div class="card">
                        <h2>Ghế của tôi: <span id="mySideLabel">@(mySide == "do" ? "Đỏ" : mySide == "den" ? "Đen" : "Chưa chọn")</span></h2>

                        <p class="muted" style="margin:6px 0;">
                            Sẵn sàng: <strong id="readyCount">@ordered.Count(p => p.IsReady && p.Role == ParticipantRole.Player)</strong>/2
                            <span id="readyHint" class="muted"></span>
                        </p>

                        <div class="row">
                            <button type="button" id="btnReady" data-ready="@(isReady ? "true" : "false")" class="ok">
                                @(isReady ? "Huỷ sẵn sàng" : "Sẵn sàng")
                            </button>
                        </div>

                        <div class="row">
                            @{
                                bool redFree = sideTaken != "do" && mySide != "do";
                                bool blackFree = sideTaken != "den" && mySide != "den";
                            }
                            <form asp-controller="Room" asp-action="SwitchSide" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="roomId" value="@Model.Id" />
                                <input type="hidden" name="side" value="do" />
                                <button type="submit" class="secondary" disabled="@(!redFree)">Ghế Đỏ</button>
                            </form>
                            <form asp-controller="Room" asp-action="SwitchSide" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="roomId" value="@Model.Id" />
                                <input type="hidden" name="side" value="den" />
                                <button type="submit" class="secondary" disabled="@(!blackFree)">Ghế Đen</button>
                            </form>
                        </div>

                        <div class="row">
                            <form asp-controller="Room" asp-action="RequestSwap" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="roomId" value="@Model.Id" />
                                <button type="submit" class="secondary" id="btnRequestSwap">Xin đổi bên</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card">
                        <h2>Bạn đang xem với vai khán giả</h2>
                        <p class="muted">
                            Hai ghế đã có người, nên bạn vào phòng với vai trò Khán giả.
                        </p>
                    </div>
                }

                @* ---------- ĐIỀU KHIỂN TRONG VÁN ----------
                   Các nút này chỉ hiện khi đã vào ván. Ở phòng chờ chúng vô nghĩa và chỉ
                   làm rối giao diện. *@
                <div class="card" id="matchControls" style="display:none;">
                    <h2>Ván đấu</h2>

                    @if (allowUndo)
                    {
                        <div class="row">
                            <button type="button" class="secondary" id="btnUndo"
                                    title="Xin đối thủ cho phép lùi 1 cặp nước. Tối đa 3 lượt mỗi bên.">
                                Xin đi lại
                            </button>
                        </div>
                    }
                    else if (isRanked)
                    {
                        @* Ván xếp hạng cấm Undo vĩnh viễn: ẩu hẳn nút, không chỉ khoá. *@
                        <div class="muted">Ván xếp hạng không cho phép xin đi lại.</div>
                    }

                    <div class="row">
                        <button type="button" class="secondary" id="btnOfferDraw">Xin hoà</button>
                        <button type="button" class="danger" id="btnResign"
                                onclick="return confirm('Bạn chắc chắn muốn đầu hàng? Bạn sẽ bị xử thua.');">
                            Đầu hàng
                        </button>
                    </div>

                    <div class="row">
                        <button type="button" id="btnMedia" class="secondary">🎥 Bật camera &amp; mic</button>
                    </div>
                    <div id="localVideoWrap" style="display:none;margin-top:10px;">
                        <video id="localVideo" autoplay muted playsinline
                               style="width:100%;max-width:220px;border-radius:8px;background:#000;"></video>
                    </div>
                </div>

                <div class="card">
                    <h2>Người trong phòng (@playerCount/2 đấu thủ &middot; @spectatorCount/@(capacity - 2) khán giả)</h2>
                    <ul class="people" id="peopleList">
                        @foreach (var p in ordered)
                        {
                            var isThisRoomOwner = p.UserId == Model.OwnerId;
                            var sideLabel = p.Side == "do" ? "Đỏ" : p.Side == "den" ? "Đen" : "Chưa chọn";
                            var isSpectator = p.Role == ParticipantRole.Spectator;
                            <li data-user-id="@p.UserId">
                                <div>
                                    <span class="who">@(p.User?.DisplayName ?? "Người chơi")</span>
                                    @if (isThisRoomOwner)
                                    {
                                        <span class="tag owner">Chủ phòng</span>
                                    }
                                    @if (p.Side != null)
                                    {
                                        <span class="tag @(p.Side == "do" ? "red" : "black")">@sideLabel</span>
                                    }
                                    <span class="tag">@(isSpectator ? "Khán giả" : "Đấu thủ")</span>
                                    <div class="@(p.IsReady ? "ready-on" : "ready-off")">
                                        @(p.IsReady ? "Đã sẵn sàng" : "Chưa sẵn sàng")
                                    </div>
                                </div>
                                @* Quyền đuổi thuộc về CẢ HAI đấu thủ (đặc tả 4.2 - 8B) và chỉ áp
                                   dụng cho khán giả. Server kiểm lại dù UI đã ẩn nút. *@
                                @if (isPlayer && isSpectator && p.UserId != currentUserId)
                                {
                                    <form asp-controller="Room" asp-action="Kick" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="roomId" value="@Model.Id" />
                                        <input type="hidden" name="targetUserId" value="@p.UserId" />
                                        <button type="submit" class="danger"
                                                onclick="return confirm('Bạn có chắc muốn đuổi @(p.User?.DisplayName) ra khỏi phòng thi đấu không?');">
                                            Đuổi
                                        </button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                </div>

                <div class="card">
                    <h2>Chia sẻ phòng</h2>
                    <label for="inviteLink">Link mời</label>
                    <input type="text" id="inviteLink" readonly
                           value="@Url.Action("JoinByCode", "Room", new { code = roomCode }, Context.Request.Scheme)" />
                    <div class="row">
                        <button type="button" class="secondary" id="btnCopyLink">Sao chép link</button>
                    </div>

                    <label for="inviteCode" style="margin-top:10px;">Mã phòng</label>
                    <input type="text" id="inviteCode" readonly value="@roomCode" />
                    <div class="row">
                        <button type="button" class="secondary" id="btnCopyCode">Sao chép mã</button>
                    </div>

                    @* Mã QR: đặc tả 2.2, mãi trỏ vào link vào phòng nên chỉ chủ phòng xem
                       được từ controller. Người khác dùng mã phòng ở trên. *@
                    @if (isOwner)
                    {
                        <div style="margin-top:12px;">
                            <div class="muted">Quét mã QR để vào phòng bằng điện thoại:</div>
                            <img class="qr" alt="Mã QR vào phòng"
                                 src="@Url.Action("QrCode", "Room", new { roomId = Model.Id, scope = "join" })" />
                            <div class="row">
                                @* Tên file phải để ngoài Razor vì "@x.svg" bị đọc nhầm
                                   thành truy cập thuộc tính .svg của biến x. *@
                                <a class="btn btn-outline-primary btn-sm" download
                                   href="@Url.Action("QrCode", "Room", new { roomId = Model.Id, scope = "join" })">
                                    Tải ảnh QR
                                </a>
                            </div>
                        </div>
                    }
                </div>

                @if (isOwner)
                {
                    <div class="card">
                        <h2>Chủ phòng</h2>

                        <form asp-controller="Room" asp-action="ChangeVisibility" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="roomId" value="@Model.Id" />
                            <label for="visSelect">Chế độ phòng</label>
                            @* selected phải sinh thuộc tính CÓ hoặc KHÔNG: selected="False"
                               vẫn bị HTML coi là có, nên phải dùng điều kiện rỗng. *@
                            <select id="visSelect" name="visibility">
                                <option value="Public" selected="@(visibility == RoomVisibility.Public ? "selected" : "")">
                                    Công khai - ai cũng thấy trong sảnh
                                </option>
                                <option value="CodeOnly" selected="@(visibility == RoomVisibility.CodeOnly ? "selected" : "")">
                                    Chỉ vào bằng mã
                                </option>
                                <option value="Locked" selected="@(visibility == RoomVisibility.Locked ? "selected" : "")">
                                    Khoá - không ai vào từ bên ngoài
                                </option>
                            </select>
                            <div class="row">
                                <button type="submit">Lưu chế độ</button>
                            </div>
                        </form>
                        <p class="muted">
                            Đổi sang <strong>Khoá</strong> sẽ ẩn phòng khỏi sảnh và chặn lượt
                            vào mới, nhưng khán giả đang ở trong vẫn xem tiếp bình thường.
                        </p>
                    </div>
                }

                @* ---------- CHAT ----------
                   Tab mặc định theo vai trò (đặc tả 5.3): đấu thủ vào Kênh Riêng,
                   khán giả chỉ thấy Kênh Chung vì không có quyền đọc kênh riêng. *@
                <div class="card">
                    <h2>Trò chuyện</h2>
                    <div class="chat-panel">
                        <div class="chat-tabs" id="chatTabs">
                            @if (isPlayer)
                            {
                                <div data-channel="0" class="active">Kênh Riêng</div>
                                <div data-channel="1">Kênh Chung</div>
                            }
                            else
                            {
                                <div data-channel="1" class="active">Kênh Chung</div>
                            }
                        </div>

                        <div class="chat-messages" id="chatMessages"></div>

                        @* Khay 12 sticker cảm xúc nhanh (đặc tả 5.1). *@
                        <div class="sticker-tray" id="stickerTray">
                            @foreach (var s in stickers)
                            {
                                <button type="button" title="@s.Label" data-code="@s.Code">@s.Emoji</button>
                            }
                        </div>

                        <div class="chat-input">
                            <button type="button" class="secondary" id="stickerToggle" title="Cảm xúc nhanh">😀</button>
                            <input type="text" id="chatInput" placeholder="Nhập tin nhắn..." maxlength="500" autocomplete="off" />
                            <button type="button" id="chatSend">Gửi</button>
                        </div>
                    </div>

                    @* Đặc tả 5.3: công tắc để đấu thủ tạm ẩn kênh chung khi muốn tập trung. *@
                    @if (isPlayer)
                    {
                        <div class="row">
                            <button type="button" class="secondary" id="btnHidePublic" style="font-size:13px;padding:6px 11px;">
                                Ẩn kênh chung
                            </button>
                        </div>
                    }
                </div>

            </div>
        </div>
        </div>

        <p class="muted" style="margin-top:14px;">
            <a asp-controller="Room" asp-action="Lobby">Về sảnh</a> &middot;
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
        </p>
    </div>

    <!-- Thứ tự nạp: âm thanh và bàn cờ phải có mặt TRƯỚC script trang. -->
    <script src="/js/audio.js"></script>
    <script src="/js/chess-board.js"></script>

    <!-- MỘT connection cho cả trang, tạo TRƯỚC script trang để không có hai
         kết nối cùng start và cùng invoke JoinRoom (sẽ ném "not in Connected State"). -->
    <script>
        window.__roomId = @Model.Id;
        window.__myUserId = @currentUserId;
        window.__pageConnection = new signalR.HubConnectionBuilder()
            .withUrl('/chessHub')
            .withAutomaticReconnect()
            .build();

        window.__readyPromise = window.__pageConnection.start().then(function () {
            var rid = parseInt(window.__roomId, 10);
            return rid > 0 ? window.__pageConnection.invoke('JoinRoom', rid, null) : null;
        });

        window.__readyPromise.catch(function (err) {
            console.error('Không kết nối được phòng:', err);
        });
    </script>

    <script>
        (function () {
            'use strict';

            const roomId = window.__roomId;
            const myUserId = window.__myUserId;
            const isPlayer = @(isPlayer ? "true" : "false");
            const isRanked = @(isRanked ? "true" : "false");
            const stickers = @Html.Raw(Json.Serialize(
                stickers.Select(s => new { s.Code, s.Emoji, s.Label }).ToArray()));

            const connection = window.__pageConnection;
            const readyPromise = window.__readyPromise;

            let currentMatchId = null;
            let chatChannel = isPlayer ? 0 : 1;
            let countdownTimer = null;
            let lastInCheck = false;
            let publicChatHidden = false;

            /* ==================== Bàn cờ ==================== */
            const boardRoot = document.getElementById('boardRoot');
            const board = window.ChessBoardView
                ? window.ChessBoardView.init(boardRoot, '/images/')
                : null;

            function setTurn(text) {
                const el = document.getElementById('turnStatus');
                if (el) el.textContent = text;
            }

            function showMatchControls(show) {
                const el = document.getElementById('matchControls');
                if (el) el.style.display = show ? '' : 'none';
            }

            /* ==================== Âm thanh ==================== */
            const soundBtn = document.getElementById('soundToggle');

            function paintSoundButton() {
                if (soundBtn && window.SoundBoard) {
                    soundBtn.textContent = window.SoundBoard.isMuted() ? '🔇' : '🔊';
                }
            }

            if (soundBtn) {
                soundBtn.addEventListener('click', function () {
                    window.SoundBoard.setMuted(!window.SoundBoard.isMuted());
                    paintSoundButton();
                    if (!window.SoundBoard.isMuted()) window.SoundBoard.playMove();
                });
                paintSoundButton();
            }

            /* ==================== Chat ==================== */
            const chatMessages = document.getElementById('chatMessages');
            const chatInput = document.getElementById('chatInput');
            const chatTabs = document.getElementById('chatTabs');
            const stickerTray = document.getElementById('stickerTray');

            function escapeHtml(value) {
                return String(value == null ? '' : value).replace(/[&<>"']/g, function (c) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                });
            }

            function renderChat(list) {
                if (!chatMessages) return;

                if (!list.length) {
                    chatMessages.innerHTML = '<div class="no-message">Chưa có tin nhắn</div>';
                    return;
                }

                // Dùng textContent cho phần chữ do server gửi: tên người chơi có thể
                // chứa ký tự '<', nếu nối thẳng vào innerHTML sẽ bị XSS.
                chatMessages.innerHTML = list.map(function (item) {
                    const mine = item.userId === myUserId ? ' mine' : '';
                    const who = item.displayName || '';
                    const text = item.kind === 1 && item.sticker
                        ? (stickerEmoji(item.sticker) || item.sticker)
                        : (item.body || '');
                    return '<div class="chat-message' + mine + '"></div>';
                }).join('');

                const nodes = chatMessages.querySelectorAll('.chat-message');
                list.forEach(function (item, i) {
                    if (!nodes[i]) return;
                    nodes[i].textContent =
                        (item.displayName || 'Người chơi') + ': ' +
                        (item.kind === 1 && item.sticker
                            ? (stickerEmoji(item.sticker) || item.sticker)
                            : (item.body || ''));
                });

                chatMessages.scrollTop = chatMessages.scrollHeight;
            }

            function stickerEmoji(code) {
                const hit = stickers.find(function (s) { return s.Code === code; });
                return hit ? hit.Emoji : null;
            }

            /* Tin nhắn nhớ theo kênh, đổi tab không mất nội dung cũ. */
            const chatHistory = { 0: [], 1: [] };

            function renderCurrentChannel() {
                renderChat(chatHistory[chatChannel] || []);
            }

            function pushChat(message) {
                const ch = message.channel === 0 ? 0 : 1;
                chatHistory[ch].push(message);

                // Không hiện tin kênh riêng của khán giả: không được đọc kênh đó.
                if (!isPlayer && ch === 0) return;

                if (ch === chatChannel) renderCurrentChannel();
            }

            function sendChat(sticker) {
                const body = chatInput ? chatInput.value.trim() : '';

                if (!body && !sticker) return;

                readyPromise
                    .then(function () {
                        return connection.invoke('SendChat', roomId, chatChannel, body, sticker || null);
                    })
                    .then(function () {
                        if (chatInput) chatInput.value = '';
                    })
                    .catch(function (err) {
                        console.error('Không gửi được tin:', err);
                    });
            }

            if (chatTabs) {
                chatTabs.querySelectorAll('div[data-channel]').forEach(function (tab) {
                    tab.addEventListener('click', function () {
                        chatChannel = parseInt(tab.getAttribute('data-channel'), 10);
                        chatTabs.querySelectorAll('div').forEach(function (t) {
                            t.classList.remove('active');
                        });
                        tab.classList.add('active');
                        renderCurrentChannel();

                        // Nạp lịch sử kênh vừa mở: đổi tab không được để trống rỗng
                        // trong khi server đã có tin cũ.
                        readyPromise
                            .then(function () {
                                return connection.invoke('GetChatHistory', roomId, chatChannel, 100);
                            })
                            .then(function (list) {
                                chatHistory[chatChannel] = list || [];
                                renderCurrentChannel();
                            })
                            .catch(function () { });
                    });
                });
            }

            const sendBtn = document.getElementById('chatSend');

            if (sendBtn) {
                sendBtn.addEventListener('click', function () { sendChat(null); });
            }

            if (chatInput) {
                chatInput.addEventListener('keyup.enter', function () { sendChat(null); });
            }

            const stickerToggle = document.getElementById('stickerToggle');

            if (stickerToggle && stickerTray) {
                stickerToggle.addEventListener('click', function () {
                    stickerTray.classList.toggle('open');
                });

                stickerTray.querySelectorAll('button[data-code]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        stickerTray.classList.remove('open');
                        sendChat(btn.getAttribute('data-code'));
                    });
                });
            }

            const hidePublicBtn = document.getElementById('btnHidePublic');

            if (hidePublicBtn) {
                hidePublicBtn.addEventListener('click', function () {
                    publicChatHidden = !publicChatHidden;

                    if (publicChatHidden) {
                        hidePublicBtn.textContent = 'Hiện kênh chung';
                        chatChannel = 0;
                        const privateTab = chatTabs.querySelector('div[data-channel="0"]');
                        if (privateTab) {
                            chatTabs.querySelectorAll('div').forEach(function (t) {
                                t.classList.remove('active');
                            });
                            privateTab.classList.add('active');
                        }
                        renderCurrentChannel();
                    } else {
                        hidePublicBtn.textContent = 'Ẩn kênh chung';
                    }
                });
            }

            connection.on('ReceiveChat', pushChat);
            connection.on('ChatRejected', function (p) {
                setTurn(p.error || 'Không gửi được tin nhắn.');
            });

            /* Nạp lịch sử kênh đang mở ngay khi vào phòng. */
            readyPromise
                .then(function () {
                    return connection.invoke('GetChatHistory', roomId, chatChannel, 100);
                })
                .then(function (list) {
                    chatHistory[chatChannel] = list || [];
                    renderCurrentChannel();
                })
                .catch(function () { });

            /* ==================== Sao chép ==================== */
            function wireCopy(buttonId, inputId) {
                const btn = document.getElementById(buttonId);
                const input = document.getElementById(inputId);
                if (!btn || !input) return;

                btn.addEventListener('click', async function () {
                    const original = btn.textContent;
                    try {
                        await navigator.clipboard.writeText(input.value);
                    } catch {
                        // Trình duyệt cũ hoặc http thường không có clipboard API.
                        input.select();
                        document.execCommand('copy');
                    }
                    btn.textContent = 'Đã sao chép';
                    setTimeout(function () { btn.textContent = original; }, 1500);
                });
            }

            wireCopy('btnCopyLink', 'inviteLink');
            wireCopy('btnCopyCode', 'inviteCode');

            /* ==================== Ghế, sẵn sàng, người chơi ==================== */
            function setSeats(participants) {
                const red = document.getElementById('seatRed');
                const black = document.getElementById('seatBlack');
                if (!red || !black) return;

                const redP = participants.find(function (p) { return p.side === 'do'; });
                const blackP = participants.find(function (p) { return p.side === 'den'; });

                red.textContent = redP ? redP.displayName : 'Trống';
                black.textContent = blackP ? blackP.displayName : 'Trống';
            }

            function updateReadyUI(participants) {
                const players = participants.filter(function (p) { return p.role === 'Player'; });
                const readyCount = players.filter(function (p) { return p.isReady; }).length;

                const counter = document.getElementById('readyCount');
                if (counter) counter.textContent = readyCount;

                const hint = document.getElementById('readyHint');
                if (hint) {
                    hint.textContent = players.length < 2
                        ? '(cần đủ 2 người)'
                        : readyCount >= 2 ? '(đủ, đang bắt đầu...)' : '(chờ đối thủ)';
                }

                const me = players.find(function (p) { return p.userId === myUserId; });
                const sideLabel = document.getElementById('mySideLabel');
                if (sideLabel && me) {
                    sideLabel.textContent = me.side === 'do' ? 'Đỏ'
                        : me.side === 'den' ? 'Đen' : 'Chưa chọn';
                }

                const btn = document.getElementById('btnReady');
                if (btn && me) {
                    btn.dataset.ready = me.isReady ? 'true' : 'false';
                    btn.textContent = me.isReady ? 'Huỷ sẵn sàng' : 'Sẵn sàng';
                }

                return { players: players, readyCount: readyCount };
            }

            /* ==================== Đếm ngược 3-2-1 ==================== */
            function startCountdown() {
                if (countdownTimer) return;

                const overlay = document.getElementById('countdown');
                const num = document.getElementById('countdownNum');
                if (!overlay || !num) return;

                overlay.classList.add('open');

                let n = 3;
                num.textContent = n;

                // Âm thanh đếm ngược: dùng tiếng gõ quân cho từng nhịp.
                countdownTimer = setInterval(function () {
                    n -= 1;

                    if (n > 0) {
                        num.textContent = n;
                        if (window.SoundBoard) window.SoundBoard.playMove();
                        return;
                    }

                    clearInterval(countdownTimer);
                    countdownTimer = null;
                    overlay.classList.remove('open');
                }, 1000);
            }

            connection.on('RoomParticipantsChanged', function (data) {
                const people = (data && data.participants) || [];
                setSeats(people);

                const state = updateReadyUI(people);

                if (state.players.length >= 2 && state.readyCount >= 2) {
                    startCountdown();
                }
            });

            connection.on('RoomStateChanged', function (data) {
                const status = document.getElementById('roomStatus');
                if (status && data.status) status.textContent = data.status;

                const mode = document.getElementById('modeLabel');
                if (mode && data.isRanked !== undefined) {
                    mode.textContent = data.isRanked ? 'Xếp hạng' : 'Đánh thường';
                }
            });

            /* Chủ phòng rời đi thì quyền được nhượng (đặc tả 2.3). */
            connection.on('HostTransferred', function () {
                setTurn('Chủ phòng đã rời đi, quyền chủ phòng được chuyển cho người khác.');
            });

            connection.on('RoomClosed', function (p) {
                setTurn(p.reason || 'Phòng đã đóng.');
                setTimeout(function () {
                    window.location.href = '/Room/Lobby';
                }, 2500);
            });

            /* Bị đuổi khỏi phòng (đặc tả 4.2). */
            connection.on('KickedFromRoom', function (p) {
                window.alert(p.message || 'Bạn đã bị đuổi khỏi phòng thi đấu.');
                window.location.href = '/Room/Lobby';
            });

            /* ==================== Vào ván ==================== */
            connection.on('MatchStarted', function (p) {
                currentMatchId = p.matchId;

                if (countdownTimer) {
                    clearInterval(countdownTimer);
                    countdownTimer = null;
                }

                const overlay = document.getElementById('countdown');
                if (overlay) overlay.classList.remove('open');

                document.body.classList.add('in-match');
                showMatchControls(true);

                if (board) {
                    board.applyMatch({
                        fen: p.fen,
                        turnSide: p.turnSide,
                        yourSide: p.redUserId === myUserId ? 0
                            : p.blackUserId === myUserId ? 1 : -1,
                        canMove: false,
                        legalMoves: []
                    });
                }

                setTurn('Ván đã bắt đầu.');
            });

            const readyBtn = document.getElementById('btnReady');

            if (readyBtn) {
                readyBtn.addEventListener('click', function () {
                    const next = readyBtn.dataset.ready !== 'true';
                    readyPromise
                        .then(function () { return connection.invoke('ToggleReady', roomId, next); })
                        .catch(function (err) { console.error(err); });
                });
            }

            /* ==================== Trong ván ==================== */
            function fmtClock(seconds) {
                if (typeof seconds !== 'number' || seconds <= 0) return '--:--';
                const m = Math.floor(seconds / 60);
                const s = Math.floor(seconds % 60);
                return m + ':' + (s < 10 ? '0' + s : s);
            }

            function paintClocks(redLeft, blackLeft) {
                const red = document.getElementById('clockRed');
                const black = document.getElementById('clockBlack');
                if (red) {
                    red.textContent = fmtClock(redLeft);
                    red.classList.toggle('low', typeof redLeft === 'number' && redLeft <= 30);
                }
                if (black) {
                    black.textContent = fmtClock(blackLeft);
                    black.classList.toggle('low', typeof blackLeft === 'number' && blackLeft <= 30);
                }
            }

            /* Đồng hồ chạy nền: server gửi mỗi giây, client chỉ hiển thị (đặc tả 3.3). */

            /* Hết đồng hồ đếm 3-2-1: MatchStarted lúc tạo ván vẫn mang danh sách
               nước hợp lệ rỗng vì đang đếm, mà không có nước đi nào xảy ra để phát
               MatchUpdated. Gọi lại GetMatchState là cách duy nhất mở khoá bàn mà
               không phải tự suy luật luật cờ ở client. */
            connection.on('MatchCountdownOver', function () {
                if (!currentMatchId) return;
                readyPromise
                    .then(function () { return connection.invoke('GetMatchState', currentMatchId); })
                    .catch(function (err) { console.error(err); });
            });
            connection.on('MatchTick', function (p) {
                // Đang đếm ngược: chỉ cập nhật con số, không vẽ lại bàn để tránh
                // nhảy quân mỗi giây. Nước hợp lệ được lấy ở MatchCountdownOver.
                if (p.countingDown) {
                    const num = document.getElementById('countdownNum');
                    if (num) num.textContent = Math.max(0, p.countdownSecondsLeft || 0);
                    return;
                }

                paintClocks(p.redTimeLeft, p.blackTimeLeft);

                if (p.disconnectedUserId) {
                    const banner = document.getElementById('disconnectBanner');
                    const text = document.getElementById('disconnectText');
                    if (banner && text) {
                        banner.style.display = '';
                        text.textContent = 'Đối thủ đang mất kết nối, thời gian chờ: '
                            + p.disconnectSecondsLeft + 's';
                    }
                }
            });

            function endReasonText(reason) {
                const map = {
                    1: 'Chiếu hết.',
                    2: 'Bên thua vì bị vây khốn.',
                    3: 'Lặp thế cờ — hoà.',
                    4: 'Đầu hàng.',
                    5: 'Hết giờ.',
                    6: 'Mất kết nối quá 60 giây.',
                    7: 'Treo ván quá lâu.',
                    8: 'Hai bên đồng ý hoà.',
                    9: 'Ván bị gián đoạn.'
                };
                return map[reason] || 'Kết thúc ván.';
            }

            function showEnd(payload) {
                const overlay = document.getElementById('endOverlay');
                const title = document.getElementById('endTitle');
                const note = document.getElementById('endNote');
                const replay = document.getElementById('btnReplayEnd');
                const rematch = document.getElementById('btnRematch');

                let headline = 'Hòa';
                if (payload.youWon === true) headline = 'Bạn thắng!';
                else if (payload.youWon === false) headline = 'Bạn thua.';

                if (title) title.textContent = headline;
                if (note) note.textContent = endReasonText(payload.endReason);
                if (replay) replay.href = '/Replay/' + payload.matchId;

                // Tái đấu chỉ mở trong cửa sổ 10 phút và khi đây là phòng thường.
                if (rematch) rematch.style.display = (payload.canRematch && !isRanked) ? '' : 'none';
                if (overlay) overlay.classList.add('open');

                if (window.SoundBoard) window.SoundBoard.playEndGame();
            }

            connection.on('MatchUpdated', function (p) {
                currentMatchId = p.matchId;
                if (board) board.applyMatch(p);

                paintClocks(p.redTimeLeft, p.blackTimeLeft);

                if (p.status === 'FINISHED') {
                    showEnd(p);
                    return;
                }

                const inCheck = p.checkSide != null;

                // Chuông chiếu tướng chỉ kêu lúc MỚI chuyển sang bị chiếu.
                if (inCheck && !lastInCheck && window.SoundBoard) {
                    window.SoundBoard.playCheck();
                }
                lastInCheck = inCheck;

                setTurn(p.canMove ? 'Đến lượt bạn.' : 'Chờ đối thủ...');
            });

            connection.on('MoveRejected', function (p) {
                setTurn(p.error || 'Nước đi bị từ chối.');
                if (window.SoundBoard) window.SoundBoard.playCheck();
            });

            /* ==================== Đi lại (đặc tả 3.2) ==================== */
            const undoBtn = document.getElementById('btnUndo');

            if (undoBtn) {
                undoBtn.addEventListener('click', function () {
                    readyPromise
                        .then(function () { return connection.invoke('RequestUndo', currentMatchId); })
                        .catch(function (err) { console.error(err); });
                });
            }

            connection.on('UndoRequested', function (p) {
                const seconds = 30;
                let left = seconds;

                const answer = confirm(
                    p.displayName + ' xin đi lại nước vừa rồi.\n'
                    + 'Đồng ý trong ' + seconds + ' giây nữa? (Từ chối = giữ nguyên, không mất lượt)');

                readyPromise
                    .then(function () { return connection.invoke('RespondUndo', currentMatchId, answer); })
                    .catch(function (err) { console.error(err); });
            });

            connection.on('UndoResolved', function (p) {
                if (p.accepted) {
                    setTurn('Đã đi lại 1 cặp nước.');
                } else if (p.expired) {
                    setTurn('Yêu cầu đi lại đã hết 30 giây và bị huỷ.');
                } else if (p.byUserId !== myUserId) {
                    setTurn('Đối thủ từ chối đi lại.');
                }

                const btn = document.getElementById('btnUndo');
                if (btn && typeof p.undoLeft === 'number') {
                    btn.disabled = p.undoLeft <= 0;
                }
            });

            connection.on('UndoRejected', function (p) {
                setTurn(p.error || 'Không xin đi lại được.');
            });

            /* ==================== Xin hoà (đặc tả 3.3) ==================== */
            const drawBtn = document.getElementById('btnOfferDraw');

            if (drawBtn) {
                drawBtn.addEventListener('click', function () {
                    readyPromise
                        .then(function () { return connection.invoke('OfferDraw', currentMatchId); })
                        .catch(function (err) { console.error(err); });
                });
            }

            connection.on('DrawOffered', function (p) {
                const accept = confirm(
                    p.displayName + ' xin hoà. Đồng ý trong 30 giây nữa?');

                readyPromise
                    .then(function () { return connection.invoke('RespondDraw', currentMatchId, accept); })
                    .catch(function (err) { console.error(err); });
            });

            connection.on('DrawOfferResolved', function (p) {
                if (!p.accepted && p.byUserId !== myUserId) {
                    setTurn(p.reason || 'Đối thủ từ chối hoà.');
                }
            });

            /* ==================== Đầu hàng + tái đấu ==================== */
            const resignBtn = document.getElementById('btnResign');

            if (resignBtn) {
                resignBtn.addEventListener('click', function () {
                    readyPromise
                        .then(function () { return connection.invoke('Resign', currentMatchId); })
                        .catch(function (err) { console.error(err); });
                });
            }

            const rematchBtn = document.getElementById('btnRematch');

            if (rematchBtn) {
                rematchBtn.addEventListener('click', function () {
                    rematchBtn.disabled = true;
                    rematchBtn.textContent = 'Đang chờ đối thủ...';

                    readyPromise
                        .then(function () {
                            return connection.invoke('RequestRematch', currentMatchId);
                        })
                        .catch(function (err) { console.error(err); });
                });
            }

            connection.on('RematchPending', function () {
                setTurn('Đã bấm tái đấu, đang chờ đối thủ đồng ý...');
            });

            /* ==================== Xin đổi bên (đặc tả 2.3) ==================== */
            connection.on('SideSwapRequested', function (p) {
                const accept = confirm(
                    p.displayName + ' xin đổi bên.\n'
                    + 'Đồng ý trong ' + p.secondsLeft + ' giây nữa?\n'
                    + 'Sau khi đổi, cả hai phải bấm sẵn sàng lại.');

                readyPromise
                    .then(function () {
                        return connection.invoke('RespondSideSwap', roomId, accept);
                    })
                    .catch(function (err) { console.error(err); });
            });

            connection.on('SideSwapResolved', function (p) {
                setTurn(p.accepted
                    ? 'Đã đổi bên. Hai bên phải bấm sẵn sàng lại.'
                    : 'Đối thủ từ chối đổi bên.');
            });

            /* ==================== Gửi nước đi ==================== */
            if (board) {
                board.onMove = function (from, to, pieceId) {
                    if (!currentMatchId) {
                        console.warn('Chưa có ván nào đang diễn ra');
                        return;
                    }

                    // Chỉ phát tiếng gõ cho nước của chính mình; nước đối thủ sẽ có
                    // tiếng riêng nếu là ăn quân.
                    if (window.SoundBoard) window.SoundBoard.playMove();

                    readyPromise
                        .then(function () {
                            return connection.invoke('SubmitMove', currentMatchId, {
                                pieceId: pieceId,
                                fromRow: from.row,
                                fromCol: from.col,
                                toRow: to.row,
                                toCol: to.col
                            });
                        })
                        .then(function (result) {
                            if (result && result.success === false) {
                                setTurn(result.error || 'Nước đi bị từ chối.');
                                if (window.SoundBoard) window.SoundBoard.playCheck();
                            }
                        })
                        .catch(function (err) { console.error(err); });
                };
            }

            /* ==================== Camera & mic (đặc tả 5.4) ====================
               Ván xếp hạng không có khán giả nên hai đấu thủ được bật cam/mic tự do.
               Mặc định TẮT để tôn trọng quyền riêng tư khi vào phòng. Khán giả KHÔNG
               có nút này (đặc tả 4.1): server cũng không cấp quyền phát cho họ. */
            const mediaBtn = document.getElementById('btnMedia');

            if (mediaBtn) {
                mediaBtn.addEventListener('click', async function () {
                    const wrap = document.getElementById('localVideoWrap');
                    const video = document.getElementById('localVideo');

                    if (wrap.style.display === 'none') {
                        try {
                            const stream = await navigator.mediaDevices.getUserMedia({
                                video: true,
                                audio: true
                            });
                            video.srcObject = stream;
                            wrap.style.display = '';
                            mediaBtn.textContent = '🎥 Tắt camera & mic';
                            mediaBtn.classList.remove('secondary');
                        } catch (err) {
                            setTurn('Không mở được camera hoặc mic (cần cấp quyền).');
                            console.error(err);
                        }
                    } else {
                        const stream = video.srcObject;
                        if (stream) stream.getTracks().forEach(function (t) { t.stop(); });
                        video.srcObject = null;
                        wrap.style.display = 'none';
                        mediaBtn.textContent = '🎥 Bật camera & mic';
                        mediaBtn.classList.add('secondary');
                    }
                });
            }

            /* ==================== Lời mời vào phòng ==================== */
            connection.on('RoomInviteReceived', function (p) {
                const popup = document.getElementById('invitePopup');
                const text = document.getElementById('inviteText');
                const timer = document.getElementById('inviteTimer');

                text.textContent = 'Kỳ thủ ' + p.fromDisplayName
                    + ' mời bạn tham gia phòng cờ "' + p.roomName + '".';

                let left = p.expiresInSeconds;
                popup.classList.add('open');
                timer.textContent = 'Hết hạn sau ' + left + ' giây';

                const tick = setInterval(function () {
                    left -= 1;
                    timer.textContent = 'Hết hạn sau ' + Math.max(0, left) + ' giây';
                    if (left <= 0) {
                        clearInterval(tick);
                        popup.classList.remove('open');
                    }
                }, 1000);

                window.__inviteToken = p.token;
            });

            const inviteAccept = document.getElementById('btnInviteAccept');
            const inviteDecline = document.getElementById('btnInviteDecline');

            if (inviteAccept) {
                inviteAccept.addEventListener('click', function () {
                    const token = window.__inviteToken;
                    readyPromise
                        .then(function () {
                            return connection.invoke('RespondRoomInvite', token, true);
                        })
                        .then(function (ok) {
                            if (ok) window.location.href = '/Room/Waiting/' + connection.inviteRoomId;
                        })
                        .catch(function (err) { console.error(err); });
                });
            }

            if (inviteDecline) {
                inviteDecline.addEventListener('click', function () {
                    const token = window.__inviteToken;
                    readyPromise
                        .then(function () { return connection.invoke('RespondRoomInvite', token, false); })
                        .catch(function (err) { console.error(err); });
                    document.getElementById('invitePopup').classList.remove('open');
                });
            }

            /* Server gửi cả roomId; lưu lại để nút Tham gia biết đường dẫn. */
            connection.on('RoomInviteAccepted', function (p) {
                if (p.roomId && document.getElementById('invitePopup')) {
                    connection.inviteRoomId = p.roomId;
                    const popup = document.getElementById('invitePopup');
                    if (popup.classList.contains('open')) {
                        window.location.href = '/Room/Waiting/' + p.roomId;
                    }
                }
            });

            connection.on('RoomInviteExpired', function () {
                document.getElementById('invitePopup').classList.remove('open');
            });

            connection.on('SocialRejected', function (p) {
                setTurn(p.error || 'Không thực hiện được yêu cầu.');
            });

            /* ==================== Công cụ demo mạng (đặc tả 9.3) ==================== */
            const demoPanel = document.getElementById('demoPanel');

            document.addEventListener('keydown', function (e) {
                if (e.ctrlKey && e.shiftKey && (e.key === 'D' || e.key === 'd')) {
                    e.preventDefault();
                    if (demoPanel) demoPanel.classList.toggle('open');
                }
            });

            const dropBtn = document.getElementById('btnDropNet');
            const reconnectBtn = document.getElementById('btnReconnect');

            if (dropBtn) {
                dropBtn.addEventListener('click', async function () {
                    setTurn('Đã ngắt kết nối (mô phỏng). Đối thủ sẽ thấy đồng hồ ân hạn 60s.');
                    try {
                        await connection.stop();
                    } catch (err) { console.error(err); }
                });
            }

            if (reconnectBtn) {
                reconnectBtn.addEventListener('click', async function () {
                    setTurn('Đang kết nối lại...');
                    try {
                        await connection.start();
                        const rid = parseInt(window.__roomId, 10);
                        await connection.invoke('JoinRoom', rid, null);
                        if (currentMatchId) {
                            await connection.invoke('DisconnectFromMatch', currentMatchId);
                        }
                        setTurn('Đã kết nối lại và đồng bộ bàn cờ.');
                    } catch (err) {
                        console.error(err);
                        setTurn('Không kết nối lại được.');
                    }
                });
            }

            /* ==================== Vẽ bàn lúc mở phòng ==================== */
            fetch('/api/BanCo/getboard')
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (board && data && Array.isArray(data.pieces) && data.pieces.length) {
                        board.setPieces(data.pieces);
                    }
                })
                .catch(function () { });

            /* Đồng bộ lại nếu vừa F5 giữa chừng một ván đang diễn ra.
               Server phải là nguồn chân lý: bàn đã đi tới đâu, lượt ai, nước hợp
               lệ ra sao. Không có bước này thì người chơi mở lại trang sẽ thấy
               thế cờ khởi tạo dù ván đã đi được mấy nước. */
            readyPromise
                .then(function () { return connection.invoke('GetRoomState', roomId); })
                .then(function (p) {
                    if (!p || !p.activeMatchId) return;

                    currentMatchId = p.activeMatchId;
                    document.body.classList.add('in-match');
                    showMatchControls(true);

                    // Ván xếp hạng không bật nút đi lại ở server, nên nếu payload
                    // báo hết lượt thì khoá nút theo cho khớp.
                    const btn = document.getElementById('btnUndo');
                    if (btn && typeof p.undoLeft === 'number') {
                        btn.disabled = p.undoLeft <= 0;
                    }
                })
                .catch(function (err) { console.error(err); });
        })();
    </script>
</body>
</html>