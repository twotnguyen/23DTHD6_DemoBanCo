@model int
@* Chấm đỏ tin nhắn chưa đọc. Model là số tin chưa đọc; 0 thì không vẽ gì.
   Dùng @await Component.InvokeAsync nên view này không cần DI, framework tự lo. *@
@if (Model > 0)
{
    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
        @Model
    </span>
}